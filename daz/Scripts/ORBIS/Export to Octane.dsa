// DAZ Studio Script — ORBIS: export the current scene to Octane X.
//
// Asks for the options (remembered between runs), saves the scene, dumps
// what DAZ Studio evaluated — posed vertices of every mesh and the rendered
// strands of strand hair — and runs the `orbis` binary on the saved scene
// and the dump; Octane X opens the .orbx from its own File → Open. On its
// first run the script adds File → Export to Octane....
//
// Installed by `orbis install`, which fills in the @…@ paths below (the
// binary lives outside the content library, so the Content Library shows
// only this script). QtScript, ECMAScript 3 style: `var`, no arrow
// functions, no `let`/`const`.

(function () {

    var sTitle = "ORBIS";
    var sActionText = "Export to Octane...";
    // Must match orbis's DUMP_FORMAT_VERSION (src/usd/dump.rs).
    var nDumpFormatVersion = 3;

    var sBin = "@ORBIS_BIN@";
    var sDefaultOutputDir = "@DEFAULT_OUTPUT_DIR@";

    var sScriptPath = getScriptFileName();
    var sPluginDir = new DzFileInfo(sScriptPath).path();

    // ── Headless dump ─────────────────────────────────────────────────────
    // scripts/dev/daz-script.sh <this script> --dump <scene.duf> <dump.json>
    // (then the content directories): open the scene, write its dump, quit.
    var aScriptArgs = App.scriptArgs;
    if (aScriptArgs.length >= 3 && aScriptArgs[0] == "--dump") {
        var oContentMgr = App.getContentMgr();
        for (var c = 3; c < aScriptArgs.length; c++) {
            oContentMgr.addContentDirectory(aScriptArgs[c], false);
        }
        oContentMgr.openFile(aScriptArgs[1], false);
        var sScene = Scene.getFilename();
        var nProgress = 0;
        startProgress(sTitle + ": reading the scene...", 300, false, false);
        var sDumpError = writeDump(aScriptArgs[2]);
        print("ORBIS dump: " + (sDumpError || "ok"));
        finishProgress();
        // Tell the caller it may stop us (quitting a big scene is slow).
        var oDone = new DzFile(aScriptArgs[2] + ".done");
        oDone.open(DzFile.WriteOnly | DzFile.Truncate);
        oDone.write(sDumpError || "ok");
        oDone.close();
        App.delayedExit();
        return;
    }

    addMenuAction();

    // ── The binary ────────────────────────────────────────────────────────
    if (!new DzFileInfo(sBin).exists()) {
        MessageBox.critical("The orbis binary is missing:\n" + sBin + "\n\nReinstall ORBIS (orbis install).", sTitle, "&OK");
        return;
    }

    // ── Options ───────────────────────────────────────────────────────────
    var oSettings = new DzAppSettings("ORBIS");
    var oOptions = {
        besideScene: oSettings.getBoolValue("besideScene", false),
        outputDir: oSettings.getStringValue("outputDir", sDefaultOutputDir),
        preview: oSettings.getBoolValue("preview", false),
        ground: oSettings.getBoolValue("ground", true),
        faithful: oSettings.getBoolValue("faithful", false),
        denoise: oSettings.getBoolValue("denoise", true)
    };
    if (!optionsDialog(oOptions)) {
        return;
    }
    oSettings.setBoolValue("besideScene", oOptions.besideScene);
    oSettings.setStringValue("outputDir", oOptions.outputDir);
    oSettings.setBoolValue("preview", oOptions.preview);
    oSettings.setBoolValue("ground", oOptions.ground);
    oSettings.setBoolValue("faithful", oOptions.faithful);
    oSettings.setBoolValue("denoise", oOptions.denoise);

    // ── The scene ─────────────────────────────────────────────────────────
    // The export reads the saved .duf (materials, cameras, lights), so save
    // first -- to its own file without asking, or asking for one if the
    // scene has none. A freshly opened scene can need saving already
    // (UltraScatter rebuilds its instances on load). Scene.saveScene()
    // without a name and File > Save's action both ask in DAZ Studio 6, and
    // the action runs only after the script has finished.
    if (!Scene.getFilename()) {
        Scene.saveScene();
    } else if (Scene.needsSave()) {
        Scene.saveScene(Scene.getFilename());
    }
    var sScene = Scene.getFilename();
    if (!sScene || Scene.needsSave()) {
        MessageBox.information("The scene is not saved - the export reads the saved .duf.", sTitle, "&OK");
        return;
    }

    // ── Dump ──────────────────────────────────────────────────────────────
    // One progress bar for both steps: 0-200 reading the scene (by node),
    // 200-300 orbis (by the percentages it reports).
    var nProgress = 0;
    startProgress(sTitle + ": reading the scene...", 300, true, true);
    var sDump = App.getTempPath() + "/orbis-scene-dump.json";
    var sError = writeDump(sDump);
    if (sError) {
        finishProgress();
        if (sError != "cancelled") {
            MessageBox.critical("Could not dump the scene:\n" + sError, sTitle, "&OK");
        }
        return;
    }

    // ── Export ────────────────────────────────────────────────────────────
    var sOutDir = oOptions.besideScene ? new DzFileInfo(sScene).path() : oOptions.outputDir;
    var aArgs = [sBin, "export", sScene, "--dump", sDump, "--out-dir", sOutDir];
    if (oOptions.preview) aArgs.push("--preview");
    if (!oOptions.ground) aArgs.push("--no-ground");
    aArgs.push("--look");
    aArgs.push(oOptions.faithful ? "faithful" : "enhanced");
    if (!oOptions.denoise) aArgs.push("--no-denoise");

    aArgs.push("--progress");

    setProgressInfo(sTitle + ": writing the Octane package...");
    var oResult = run(aArgs, true);
    finishProgress();
    if (oResult.cancelled) {
        return;
    }

    if (oResult.ok) {
        showReport(oResult.out);
    } else {
        MessageBox.critical("The export failed.\n\n" + oResult.out + "\n" + oResult.err, sTitle, "&OK");
    }

    // ── Functions ─────────────────────────────────────────────────────────

    // Advance the progress bar to nTo (of 300).
    function progressTo(nTo) {
        if (nTo > nProgress) {
            stepProgress(nTo - nProgress);
            nProgress = nTo;
        }
    }

    // orbis's report: the summary on top; what was left out or not found
    // (a list that can run long) in a scrolling box below.
    function showReport(sOut) {
        var aLines = sOut.split("\n");
        var aSummary = [];
        var aDetails = [];
        var sOrbx = "";
        for (var i = 0; i < aLines.length; i++) {
            var sLine = aLines[i];
            if (sLine.indexOf("skipped: ") == 0 || sLine.indexOf("missing texture: ") == 0) {
                aDetails.push(sLine);
            } else if (sLine.indexOf("done: ") == 0) {
                sOrbx = sLine.substring(6);
            } else if (sLine && sLine.indexOf("exporting ") != 0) {
                aSummary.push(sLine);
            }
        }
        aSummary.push("");
        aSummary.push("Saved: " + sOrbx);
        if (aDetails.length == 0) {
            MessageBox.information(aSummary.join("\n"), sTitle, "&OK");
            return;
        }
        var wDlg = new DzBasicDialog();
        wDlg.caption = sTitle + " - Exported";
        wDlg.showCancelButton(false);
        wDlg.setAcceptButtonText("OK");
        var wSummary = new DzLabel(wDlg);
        wSummary.text = aSummary.join("\n");
        wDlg.addWidget(wSummary);
        wDlg.addWidget(heading(wDlg, "Details (" + aDetails.length + ")"));
        var wDetails = new DzTextEdit(wDlg);
        wDetails.readOnly = true;
        wDetails.plainText = aDetails.join("\n");
        wDetails.minWidth = 560;
        wDetails.minHeight = 180;
        wDlg.addWidget(wDetails, 1);
        centerOnMainWindow(wDlg);
        wDlg.exec();
    }

    // The options dialog; fills oOpt and returns true on Export. Plain
    // widgets with label headings: group boxes in DAZ Studio 6 squeeze
    // their contents into scroll areas.
    function optionsDialog(oOpt) {
        var wDlg = new DzBasicDialog();
        wDlg.caption = sTitle + " - Export to Octane";
        wDlg.setAcceptButtonText("Export");

        wDlg.addWidget(heading(wDlg, "Save the .orbx"));
        // Radio buttons sharing a parent are exclusive.
        var wOutput = new DzWidget(wDlg);
        var lOutput = new DzVBoxLayout(wOutput);
        lOutput.margin = 0;
        var wBeside = new DzRadioButton(wOutput);
        wBeside.text = "Beside the scene";
        lOutput.addWidget(wBeside);
        var wInFolder = new DzRadioButton(wOutput);
        wInFolder.text = "In this folder:";
        lOutput.addWidget(wInFolder);
        var wRow = new DzWidget(wOutput);
        var lRow = new DzHBoxLayout(wRow);
        lRow.margin = 0;
        var wPath = new DzLineEdit(wRow);
        wPath.text = oOpt.outputDir;
        wPath.minWidth = 360;
        lRow.addWidget(wPath, 1);
        var wChoose = new DzPushButton(wRow);
        wChoose.text = "Choose...";
        lRow.addWidget(wChoose);
        lOutput.addWidget(wRow);
        wDlg.addWidget(wOutput);
        wBeside.checked = oOpt.besideScene;
        wInFolder.checked = !oOpt.besideScene;
        var syncRow = function () {
            wRow.enabled = wInFolder.checked;
        };
        syncRow();
        connect(wInFolder, "toggled(bool)", syncRow);
        connect(wChoose, "clicked()", function () {
            var sDir = FileDialog.doDirectoryDialog("Save the .orbx in", "", wPath.text, wDlg);
            if (sDir) wPath.text = sDir;
        });

        wDlg.addSpacing(8);
        wDlg.addWidget(heading(wDlg, "Octane"));
        var wPreview = new DzCheckBox(wDlg);
        wPreview.text = "Fast preview (direct lighting, no subsurface)";
        wPreview.checked = oOpt.preview;
        wDlg.addWidget(wPreview);
        var wGround = new DzCheckBox(wDlg);
        wGround.text = "Shadow-catching ground (when Iray draws one)";
        wGround.checked = oOpt.ground;
        wDlg.addWidget(wGround);
        var wDenoise = new DzCheckBox(wDlg);
        wDenoise.text = "Denoise (Octane's AI denoiser)";
        wDenoise.checked = oOpt.denoise;
        wDlg.addWidget(wDenoise);

        wDlg.addSpacing(8);
        wDlg.addWidget(heading(wDlg, "Look"));
        // Radio buttons sharing a parent are exclusive.
        var wLook = new DzWidget(wDlg);
        var lLook = new DzVBoxLayout(wLook);
        lLook.margin = 0;
        var wEnhanced = new DzRadioButton(wLook);
        wEnhanced.text = "Enhanced: Octane's take where it is more natural (OpenPBR skin, warm low sun)";
        lLook.addWidget(wEnhanced);
        var wFaithful = new DzRadioButton(wLook);
        wFaithful.text = "Faithful: as close to Iray as possible";
        lLook.addWidget(wFaithful);
        wDlg.addWidget(wLook);
        wEnhanced.checked = !oOpt.faithful;
        wFaithful.checked = oOpt.faithful;

        centerOnMainWindow(wDlg);
        if (!wDlg.exec()) {
            return false;
        }
        oOpt.besideScene = wBeside.checked;
        oOpt.outputDir = wPath.text;
        oOpt.preview = wPreview.checked;
        oOpt.ground = wGround.checked;
        oOpt.faithful = wFaithful.checked;
        oOpt.denoise = wDenoise.checked;
        return true;
    }

    // Put a dialog in the middle of DAZ Studio's window (a DzBasicDialog
    // opens wherever the window system puts it). Cosmetic: never fails.
    function centerOnMainWindow(wDlg) {
        try {
            var oDlg = wDlg.getWidget();
            var oHint = oDlg.sizeHint;
            var oMain = MainWindow.geometry;
            oDlg.pos = new Point(oMain.x + Math.round((oMain.width - oHint.width) / 2),
                oMain.y + Math.round((oMain.height - oHint.height) / 2));
        } catch (e) {
            print(sTitle + ": cannot center the dialog: " + e);
        }
    }

    function heading(wParent, sText) {
        var wLabel = new DzLabel(wParent);
        wLabel.text = "<b>" + sText + "</b>";
        return wLabel;
    }

    // Add File → Export to Octane... (after File → Export...) unless there
    // is such an action already; a reinstall elsewhere repoints it.
    function addMenuAction() {
        var oMgr = MainWindow.getActionMgr();
        if (!oMgr) return; // headless
        var sIcon = sPluginDir + "/Export to Octane.png";
        for (var i = 0; i < oMgr.getNumCustomActions(); i++) {
            if (oMgr.getCustomActionText(i) == sActionText) {
                if (oMgr.getCustomActionFile(i) != sScriptPath) {
                    oMgr.setCustomActionScript(i, sScriptPath, true);
                    oMgr.setCustomActionIcon(i, sIcon);
                }
                return;
            }
        }
        var sGuid = oMgr.addCustomAction(sActionText, "Export the scene to Octane X (ORBIS)", sScriptPath, true, "", sIcon);
        var oFile = oMgr.getMenu().findSubMenu("&File");
        if (!oFile) return;
        var nAt = -1;
        for (var j = 0; j < oFile.getNumItems(); j++) {
            if (oFile.getItem(j).label == "&Export...") nAt = j + 1;
        }
        oFile.insertCustomAction(sGuid, nAt);
    }

    // Write the scene dump (format: docs/spec/octane-export.md); returns ""
    // or what went wrong ("cancelled" when the user stopped it).
    function writeDump(sPath) {
        var oFile = new DzFile(sPath);
        if (!oFile.open(DzFile.WriteOnly | DzFile.Truncate)) {
            return "cannot write " + sPath;
        }
        var oContent = App.getContentMgr();
        var aContent = [];
        for (var i = 0; i < oContent.getNumContentDirectories(); i++) {
            aContent.push(jsonString(oContent.getContentDirectoryPath(i)));
        }
        var aMdl = [];
        for (var k = 0; k < oContent.getNumBuiltInMDLDirectories(); k++) {
            aMdl.push(jsonString(oContent.getBuiltInMDLDirectoryPath(k)));
        }
        oFile.write("{\"format\":\"orbis-scene-dump\",\"format_version\":" + nDumpFormatVersion +
            ",\"daz_version\":" + jsonString(App.longVersionString) +
            ",\"scene\":" + jsonString(sScene) +
            ",\"content_dirs\":[" + aContent.join(",") + "]" +
            ",\"builtin_mdl_dirs\":[" + aMdl.join(",") + "]" +
            ",\"nodes\":[");

        var nNodes = Scene.getNumNodes();
        var bFirst = true;
        var bCancelled = false;
        var aInstances = [];
        // Every mesh at its base resolution at once: a geometry shell copies
        // its host's cached geometry, so the host has to stay at LOD 0 while
        // the shell is read. Our export refines the base meshes as DAZ does.
        // dForce hair renders its render generator's strands ("PR hairs");
        // the viewport shows the guides unless "Preview Pre Render Hairs"
        // is on (Cute Braids: 3374 guides, 51473 rendered strands).
        var aHairs = renderHairs();
        var aLods = baseResolution();
        for (var n = 0; n < nNodes; n++) {
            progressTo(Math.round(200 * (n + 1) / nNodes));
            if (progressIsCancelled()) {
                bCancelled = true;
                break;
            }
            var oNode = Scene.getNode(n);
            if (oNode.inherits("DzInstanceNode")) {
                dumpInstances(oNode, aInstances);
                continue;
            }
            if (dumpNode(oNode, lodOf(aLods, oNode), oFile, bFirst)) {
                bFirst = false;
            }
        }
        for (var r = 0; r < aLods.length; r++) {
            aLods[r].control.setValue(aLods[r].value);
        }
        for (var h = 0; h < aHairs.length; h++) {
            aHairs[h].setValue(false);
        }
        oFile.write("],\"instances\":[" + aInstances.join(",") + "]}");
        oFile.close();
        return bCancelled ? "cancelled" : "";
    }

    // Switch every mesh with a resolution level above 0 to its base mesh
    // and rebuild the caches (hosts first, as the scene lists them); returns
    // what to restore: [{ node, control, value }].
    function baseResolution() {
        var aLods = [];
        var aObjects = [];
        for (var n = 0; n < Scene.getNumNodes(); n++) {
            var oNode = Scene.getNode(n);
            if (oNode.inherits("DzBone")) continue;
            var oObject = oNode.getObject();
            var oShape = oObject ? oObject.getCurrentShape() : null;
            if (!oShape) continue;
            aObjects.push({ node: oNode, object: oObject });
            var oLod = oShape.getLODControl ? oShape.getLODControl() : null;
            if (oLod && oLod.getValue() != 0) {
                aLods.push({ node: oNode, control: oLod, value: oLod.getValue() });
                oLod.setValue(0);
            }
        }
        for (var i = 0; i < aObjects.length; i++) {
            aObjects[i].node.finalize();
            aObjects[i].object.forceCacheUpdate(aObjects[i].node, false);
        }
        return aLods;
    }

    // Switch on every dForce render hair generator's "Preview Pre Render
    // Hairs" that is off; returns the properties to switch off again (the
    // caches are rebuilt by baseResolution()).
    function renderHairs() {
        var aOut = [];
        for (var n = 0; n < Scene.getNumNodes(); n++) {
            var oNode = Scene.getNode(n);
            var oObject = oNode.inherits("DzBone") ? null : oNode.getObject();
            if (!oObject) continue;
            for (var m = 0; m < oObject.getNumModifiers(); m++) {
                var oMod = oObject.getModifier(m);
                var oProp = oMod.findProperty ? oMod.findProperty("Preview Pre Render Hairs") : null;
                if (oProp && !oProp.getValue()) {
                    oProp.setValue(true);
                    aOut.push(oProp);
                }
            }
        }
        return aOut;
    }

    // The resolution level oNode renders at (before baseResolution()).
    function lodOf(aLods, oNode) {
        for (var i = 0; i < aLods.length; i++) {
            if (aLods[i].node == oNode) return aLods[i].value;
        }
        return 0;
    }

    // One node as JSON onto oFile (after a comma unless bFirst); false when
    // it has no geometry: the base mesh with morphs and pose applied, world
    // space, cm to 0.01 mm; strand hair as polylines. Written in chunks —
    // a render hair generator's millions of points built as one string
    // took DAZ 20 minutes and 10 GB.
    function dumpNode(oNode, nLod, oFile, bFirst) {
        if (oNode.inherits("DzBone")) return false;
        var oObject = oNode.getObject();
        if (!oObject || !oObject.getCurrentShape()) return false;
        var oGeom = oObject.getCachedGeom();
        if (!oGeom || oGeom.getNumVertices() == 0) return false;
        var aParts = [
            "{\"name\":" + jsonString(oNode.name),
            "\"label\":" + jsonString(oNode.getLabel()),
            "\"class\":" + jsonString(oNode.className()),
            "\"lod\":" + nLod,
            "\"transform\":" + matrixJson(oNode.getWSTransform())
        ];
        var aGroups = [];
        for (var g = 0; g < oGeom.getNumMaterialGroups(); g++) {
            aGroups.push(jsonString(oGeom.getMaterialGroup(g).name));
        }
        aParts.push("\"material_groups\":[" + aGroups.join(",") + "]");
        oFile.write((bFirst ? "" : ",") + aParts.join(",") + ",\"vertices\":[");
        var nVerts = oGeom.getNumVertices();
        var nChunk = 20000;
        for (var v0 = 0; v0 < nVerts; v0 += nChunk) {
            var nEnd = Math.min(v0 + nChunk, nVerts);
            var aVerts = new Array(nEnd - v0);
            for (var v = v0; v < nEnd; v++) {
                var p = oGeom.getVertex(v);
                aVerts[v - v0] = p.x.toFixed(3) + "," + p.y.toFixed(3) + "," + p.z.toFixed(3);
            }
            oFile.write((v0 > 0 ? "," : "") + aVerts.join(","));
        }
        oFile.write("]");
        if (oGeom.getNumFacets() == 0 && oGeom.getNumPolylines) {
            // Strands are runs of consecutive vertices: their lengths do,
            // else every strand's indices.
            var nLines = oGeom.getNumPolylines();
            var aCounts = new Array(nLines);
            var aLineMats = new Array(nLines);
            var nNext = 0;
            var bRuns = true;
            for (var l = 0; l < nLines; l++) {
                var aIdx = oGeom.getPolylineVertexIndices(l);
                aCounts[l] = aIdx.length;
                if (bRuns && (aIdx[0] != nNext || aIdx[aIdx.length - 1] != nNext + aIdx.length - 1)) bRuns = false;
                nNext += aIdx.length;
                aLineMats[l] = oGeom.getPolylineMaterialGroupIndex(l);
            }
            if (bRuns) {
                oFile.write(",\"polyline_counts\":[" + aCounts.join(",") + "]");
            } else {
                oFile.write(",\"polylines\":[");
                for (var q = 0; q < nLines; q++) {
                    oFile.write((q ? "," : "") + "[" + oGeom.getPolylineVertexIndices(q).join(",") + "]");
                }
                oFile.write("]");
            }
            oFile.write(",\"polyline_materials\":[" + aLineMats.join(",") + "]");
        }
        oFile.write("}");
        return true;
    }

    // The instances an instance node renders, as JSON onto aOut: its target
    // and a world-space transform per copy -- one for a DzInstanceNode, one
    // per item for a DzInstanceGroupNode (UltraScatter). Hidden ones and
    // those without a target (UltraScatter's viewport proxies) are left out.
    function dumpInstances(oNode, aOut) {
        var oTarget = oNode.getTarget();
        if (!oTarget || !oNode.isVisible()) return;
        if (oNode.isVisibleInRender && !oNode.isVisibleInRender()) return;
        var sHead = "{\"name\":" + jsonString(oNode.name) +
            ",\"label\":" + jsonString(oNode.getLabel()) +
            ",\"target_name\":" + jsonString(oTarget.name) +
            ",\"target_label\":" + jsonString(oTarget.getLabel()) +
            ",\"transforms\":[";
        var aTms = [];
        if (oNode.inherits("DzInstanceGroupNode")) {
            var nItems = oNode.getNumberOfGroupItems();
            for (var i = 0; i < nItems; i++) {
                aTms.push(matrixJson(oNode.getGroupItem(i).getWSTransform()));
            }
        } else {
            aTms.push(matrixJson(oNode.getWSTransform()));
        }
        if (aTms.length > 0) aOut.push(sHead + aTms.join(",") + "]}");
    }

    // A DzMatrix3 as [m11, m12, m13, m14, m21, ..., m34]: rows of the 3x4
    // affine transform, the 4th column the translation (cm).
    function matrixJson(m) {
        return "[" + [m.m11, m.m12, m.m13, m.m14, m.m21, m.m22, m.m23, m.m24, m.m31, m.m32, m.m33, m.m34].join(",") + "]";
    }

    // A JSON string literal, ASCII only (anything else as \uXXXX).
    function jsonString(s) {
        s = String(s);
        var aOut = ["\""];
        for (var i = 0; i < s.length; i++) {
            var c = s.charCodeAt(i);
            var ch = s.charAt(i);
            if (ch == "\"" || ch == "\\") {
                aOut.push("\\" + ch);
            } else if (c < 0x20 || c > 0x7e) {
                var h = c.toString(16);
                aOut.push("\\u" + "0000".substring(h.length) + h);
            } else {
                aOut.push(ch);
            }
        }
        aOut.push("\"");
        return aOut.join("");
    }

    // Run aArgs[0] with the rest as arguments, wait for it and collect its
    // stdout and stderr; with bCancellable the progress dialog's Cancel
    // kills it.
    function run(aArgs, bCancellable) {
        var oProcess = new DzProcess(aArgs);
        oProcess.communication = DzProcess.Stdout | DzProcess.Stderr;
        var aOut = [];
        if (!oProcess.start()) {
            return { ok: false, cancelled: false, out: "", err: "Could not start " + aArgs[0] };
        }
        // `progress: <percent> <what>` lines drive the progress bar.
        var drain = function () {
            while (oProcess.canReadLineStdout()) {
                var sLine = String(oProcess.readLineStdout());
                var aMatch = /^progress: (\d+) (.*)/.exec(sLine);
                if (aMatch) {
                    progressTo(200 + Number(aMatch[1]));
                    setProgressInfo(sTitle + ": " + aMatch[2] + "...");
                } else {
                    aOut.push(sLine);
                }
            }
        };
        // `running` per the API reference; `isRunning()` in older builds.
        var isRunning = function () {
            return typeof oProcess.isRunning == "function" ? oProcess.isRunning() : oProcess.running;
        };
        var bCancelled = false;
        while (isRunning()) {
            drain();
            processEvents();
            if (bCancellable && progressIsCancelled()) {
                oProcess.kill();
                bCancelled = true;
                break;
            }
            sleep(100);
        }
        drain();
        var sErr = String(oProcess.readStderr());
        print(sTitle + ": " + aOut.join("\n"));
        if (sErr) print(sTitle + " (stderr): " + sErr);
        return {
            ok: !bCancelled && oProcess.normalExit && oProcess.exitStatus == 0,
            cancelled: bCancelled,
            out: aOut.join("\n"),
            err: sErr
        };
    }

})();
