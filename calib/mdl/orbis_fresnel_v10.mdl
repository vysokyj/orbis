// ORBIS calibration module (#207), written for ORBIS (GPL-3.0-or-later).
// Architectural glass's "Use Fresnel Term" stack written out: fresnel_layer
// (IOR 1.5, weight w) of a mirror reflection over the closed transmit-only
// lobe at a constant roughness r, at "mdl 1.0". Calib-Furnace-ArchGlass G8
// keeps 0.412 where `libbsdf`'s layering with the 1.0 lobe's per-event loss
// as a factor predicts 0.396 (the Schlick twin G7 matches): is it the 1.0
// reading of fresnel_layer, and does the legacy loss fall on the widest
// microfacets (the ones the critical-angle weight already takes)?
mdl 1.0;

import df::*;

export material fresnel_w06_r06() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::fresnel_layer(ior: color(1.5), weight: 0.6, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.6, roughness_v: 0.6))));

export material fresnel_w1_r06() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::fresnel_layer(ior: color(1.5), weight: 1.0, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.6, roughness_v: 0.6))));

export material fresnel_w06_r03() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::fresnel_layer(ior: color(1.5), weight: 0.6, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.3, roughness_v: 0.3))));

export material fresnel_w06_r1() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::fresnel_layer(ior: color(1.5), weight: 0.6, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 1.0, roughness_v: 1.0))));

export material fresnel_w0_r06() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::fresnel_layer(ior: color(1.5), weight: 0.0, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.6, roughness_v: 0.6))));

export material schlick004_w06_r06() = material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::custom_curve_layer(normal_reflectivity: 0.04, grazing_reflectivity: 1.0, exponent: 5.0, weight: 0.6, layer: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.0, roughness_v: 0.0), base: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.6, roughness_v: 0.6))));
