// ORBIS calibration module (#117, third round), written for ORBIS
// (GPL-3.0-or-later). The "mdl 1.3" transmit lobe at r 0.6 / 1: thin walls
// (Calib-Furnace-MdlLegacy K6 / K7) lose more per event than the closed
// spheres at IOR 1.5 (K2 - K4) let a per-event g apply, so g isn't wall-
// and IOR-independent above r 0.3 - or the `libbsdf` thin wall it was read
// against is off there. The current lobe's thin walls at r 0.6 /
// 1 (is `libbsdf`'s thin model right there?) and closed at IOR 1.05 r 1. White.
mdl 1.3;

import df::*;

export material thin_r06() = material(
    thin_walled: true,
    ior: color(1.5),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 0.6, roughness_v: 0.6)));

export material thin_r1() = material(
    thin_walled: true,
    ior: color(1.5),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 1.0, roughness_v: 1.0)));

export material ior105_r1() = material(
    ior: color(1.05),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_transmit, tint: color(1.0), roughness_u: 1.0, roughness_v: 1.0)));
