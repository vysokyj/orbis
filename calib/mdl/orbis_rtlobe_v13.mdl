    ior: color(1.49),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_reflect_transmit, tint: color(1.0), roughness_u: 0.3434, roughness_v: 0.3434)),
    volume: material_volume(absorption_coefficient: color(1000.0)));

export material twin_r05() = material(
    ior: color(1.49),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_reflect_transmit, tint: color(1.0), roughness_u: 0.4714, roughness_v: 0.4714)),
