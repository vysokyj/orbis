export material twin_r07() = material(
    ior: color(1.49),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_reflect_transmit, tint: color(1.0), roughness_u: 0.6274, roughness_v: 0.6274)),
