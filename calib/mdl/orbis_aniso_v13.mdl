// ORBIS calibration module (#114), written for ORBIS (GPL-3.0-or-later).
// orbis_aniso_v10.mdl at "mdl 1.3", the first version whose
// df::simple_glossy_bsdf is specified (Phong microfacets, v-cavities) and
// that Iray reads without its legacy behaviour; DAZ's Uber (1.7) has the
// same lobe. White, reflect only.
mdl 1.3;

import df::*;
import base::*;

export material iso_r02() = material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.2, roughness_v: 0.2)));

export material aniso_u04_v01() = material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(mode: df::scatter_reflect, tint: color(1.0), roughness_u: 0.4, roughness_v: 0.1)));

export material arch_g0_iso() = material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            mode: df::scatter_reflect, tint: color(1.0),
            roughness_u: base::architectural_gloss_to_rough(0.0),
            roughness_v: base::architectural_gloss_to_rough(0.0))));

export material arch_g0_a4() = let {
    base::anisotropy_return a = base::anisotropy_conversion(
        roughness: base::architectural_gloss_to_rough(0.0),
        anisotropy: 4.0,
        anisotropy_rotation: 0.0,
        mia_anisotropy_semantic: true);
} in material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            mode: df::scatter_reflect, tint: color(1.0),
            roughness_u: a.roughness_u, roughness_v: a.roughness_v, tangent_u: a.tangent_u)));
