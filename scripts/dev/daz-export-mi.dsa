// ORBIS: export scenes to Iray's .mi (DzMIExporter), headless through
// scripts/dev/daz-script.sh. The .mi holds the
// MDL argument values DAZ Studio computes from the Uber channels - the
// compiled channel -> parameter mapping (docs/daz/iray-uber-mdl.md).
// Arguments: out dir, scene .duf files, "--", then the content directories
// (daz-script.sh appends them); writes <out dir>/<scene>.mi each, its
// <scene>.lowest.json (where DAZ's auto ground measures, #228) and
// <out dir>/export-mi.done (DONE_FILE) with a log.
// ECMAScript 3, ASCII only.
(function () {
    var a = App.scriptArgs;
    var sOut = a[0], aScenes = [], i = 1;
    for (; i < a.length && a[i] != "--"; i++) aScenes.push(a[i]);
    var oContent = App.getContentMgr();
    for (i++; i < a.length; i++) oContent.addContentDirectory(a[i], false);
    var sLog = "args " + a.length + ": " + a.join(" | ") + "\n";
    function log(s) { sLog += s + "\n"; }
    // Our own MDL modules (make-mdl-scenes.py, #112) live in
    // <content dir>/shaders/iray, which DAZ doesn't search by itself: map
    // each such folder as an MDL directory for this session only.
    for (var c = 0; c < oContent.getNumContentDirectories(); c++) {
        var sMdl = oContent.getContentDirectoryPath(c) + "/shaders/iray";
        if (new DzDir(sMdl).exists()) {
            oContent.addMDLDirectory(sMdl, false);
            log("MDL dir " + sMdl);
        }
    }
    // Iray takes the new paths from a posted event: let it run first.
    processEvents();
    var oMgr = App.getExportMgr();
    var oExporter = null;
    for (var e = 0; e < oMgr.getNumExporters(); e++) {
        if (oMgr.getExporter(e).className() == "DzMIExporter") oExporter = oMgr.getExporter(e);
    }
    // #153: a scene exported right after a scene that used the same shader
    // brick (PBRSkin after PBRSkin) got every such surface as a default
    // Iray Uber or an empty pass_material, nothing in DAZ's log: the
    // previous scene's Iray data is torn down in the background after
    // Scene.clear(), and a module still being released is skipped. Waiting
    // cures it (2 s did; processEvents() alone did not), so wait after each
    // clear, and check the export: shader bricks in the scene (other than
    // those DAZ hands Iray as Uber) need a module beyond the Uber's in the
    // .shader_decl.mi. A scene loaded too early stays wrong however long
    // one waits before exporting again, so clear, wait longer, reopen; in
    // the end say FAILED rather than leave a wrong fixture (mi-oracle.py
    // checks each surface too: mi-audit.py). Each export goes to a scratch
    // folder (<out dir>/export-mi.tmp, same file names: the .mi includes its
    // .shader_decl.mi by name) and replaces the out dir's files only when it
    // passed, so a refused export leaves an earlier valid .mi in place (#224).
    var aAsUber = ["AoA_Subsurface"];
    var aUberModules = ["base.mdl", "state.mdl", "math.mdl", "daz_3d::irayubermaterial.mdl", "daz_3d::basic.mdl"];
    function has(a, x) {
        for (var h = 0; h < a.length; h++) if (a[h] == x) return true;
        return false;
    }
    // #224: a hidden node (Visible or Visible in Render off, or under a
    // hidden group: isVisible()) is not in DAZ's .mi at all, its materials
    // neither (a hidden Genesis 9 with PBRSkin added no module), so its
    // bricks are not expected there - the same test as the scene dump's.
    function bricks() {
        var aOut = [];
        for (var n = 0; n < Scene.getNumNodes(); n++) {
            var oNode = Scene.getNode(n);
            if (!oNode.isVisible()) continue;
            if (oNode.isVisibleInRender && !oNode.isVisibleInRender()) continue;
            var oObj = oNode.getObject();
            var oShape = oObj ? oObj.getCurrentShape() : null;
            for (var m = 0; oShape && m < oShape.getNumMaterials(); m++) {
                var oMat = oShape.getMaterial(m);
                if (oMat.className() != "DzBrickMaterial") continue;
                var sMat = oMat.getMaterialName();
                if (!has(aAsUber, sMat) && !has(aOut, sMat)) aOut.push(sMat);
            }
        }
        return aOut;
    }
    function brickModules(sMi) {
        var f = new DzFile(sMi.replace(/\.mi$/, ".shader_decl.mi"));
        if (!f.open(DzFile.ReadOnly)) return [];
        var aLines = String(f.read()).split("\n"), aOut = [];
        f.close();
        for (var l = 0; l < aLines.length; l++) {
            var aM = aLines[l].match(/\$include "([^"]+)"/);
            if (aM && !has(aUberModules, aM[1])) aOut.push(aM[1]);
        }
        return aOut;
    }
    function settle(ms) {
        sleep(ms);
        processEvents();
    }
    var sTmp = sOut + "/export-mi.tmp";
    new DzDir(sOut).mkpath(sTmp);
    function tmpFiles() {
        return new DzDir(sTmp).entryList(["*"], DzDir.Files);
    }
    function clearTmp() {
        var aF = tmpFiles();
        for (var t = 0; t < aF.length; t++) new DzFile(sTmp + "/" + aF[t]).remove();
    }
    // Moves the scratch folder's files into the out dir, replacing theirs.
    function keepTmp() {
        var aF = tmpFiles();
        for (var t = 0; t < aF.length; t++) {
            var sDest = sOut + "/" + aF[t];
            if (new DzFile(sDest).exists()) new DzFile(sDest).remove();
            if (!new DzFile(sTmp + "/" + aF[t]).rename(sDest)) log("cannot move " + aF[t] + " to " + sOut);
        }
    }
    // #228: where DAZ's auto Iray ground comes from. For every visible node
    // with geometry: the lowest world y (cm, full precision) of its cached
    // geometry as the scene is (a SubD figure at its resolution level: the
    // viewport's refinement), of its world bounding box, and of its cached
    // geometry at the base resolution (the control cage, as the scene dump
    // takes it). Written to <scene>.lowest.json beside the .mi; mi-oracle.py
    // takes it into the fixture. Call after the export: it switches the
    // resolution levels down.
    function lowY(oGeom) {
        var y = null;
        for (var v = 0; oGeom && v < oGeom.getNumVertices(); v++) {
            var p = oGeom.getVertex(v);
            if (y === null || p.y < y) y = p.y;
        }
        return y;
    }
    function meshNodes() {
        var aOut = [];
        for (var n = 0; n < Scene.getNumNodes(); n++) {
            var oNode = Scene.getNode(n);
            if (oNode.inherits("DzBone") || oNode.inherits("DzInstanceNode")) continue;
            if (!oNode.isVisible()) continue;
            if (oNode.isVisibleInRender && !oNode.isVisibleInRender()) continue;
            var oObj = oNode.getObject();
            if (!oObj || !oObj.getCurrentShape()) continue;
            aOut.push(oNode);
        }
        return aOut;
    }
    function lowest() {
        var aNodes = meshNodes(), aRows = [];
        for (var n = 0; n < aNodes.length; n++) {
            var oNode = aNodes[n], oShape = oNode.getObject().getCurrentShape();
            var oBox = oNode.getWSBoundingBox ? oNode.getWSBoundingBox() : null;
            var oLod = oShape.getLODControl ? oShape.getLODControl() : null;
            aRows.push({ label: oNode.getLabel(), lod: oLod ? oLod.getValue() : 0, cached: lowY(oNode.getObject().getCachedGeom()), box: oBox ? oBox.min.y : null });
            if (oLod && oLod.getValue() != 0) oLod.setValue(0);
        }
        for (var pass = 0; pass < 2; pass++) {
            processEvents();
            for (var b = 0; b < aNodes.length; b++) {
                aNodes[b].finalize();
                aNodes[b].getObject().forceCacheUpdate(aNodes[b], true);
            }
        }
        var aJson = [];
        for (var r = 0; r < aRows.length; r++) {
            aRows[r].base = lowY(aNodes[r].getObject().getCachedGeom());
            var o = aRows[r];
            aJson.push("{\"label\":\"" + String(o.label).replace(/["\\]/g, "\\$&") + "\",\"lod\":" + o.lod + ",\"cached\":" + o.cached + ",\"box\":" + o.box + ",\"base\":" + o.base + "}");
        }
        return "[" + aJson.join(",\n") + "]\n";
    }
    function writeText(sPath, s) {
        var f = new DzFile(sPath);
        f.open(DzFile.WriteOnly | DzFile.Truncate);
        f.write(s);
        f.close();
    }
    var nFailed = 0;
    for (var k = 0; oExporter && k < aScenes.length; k++) {
        var sName = aScenes[k].replace(/^.*\//, "").replace(/\.duf$/, "");
        var sMi = sTmp + "/" + sName + ".mi";
        var aBricks = [], oResult, aModules = [], bOpened = false;
        for (var iTry = 0; iTry < 3; iTry++) {
            if (iTry > 0) {
                Scene.clear();
                settle(5000);
            }
            bOpened = oContent.openFile(aScenes[k], false);
            if (!bOpened) break;
            clearTmp();
            aBricks = bricks();
            oResult = oExporter.writeFile(sMi);
            aModules = brickModules(sMi);
            if (aBricks.length == 0 || aModules.length > 0) break;
            log(sName + ": bricks " + aBricks.join(", ") + " but no brick module in the .mi (try " + (iTry + 1) + ")");
        }
        if (!bOpened) {
            log(sName + ": FAILED - not opened");
            nFailed++;
        } else if (aBricks.length > 0 && aModules.length == 0) {
            log(sName + ": FAILED - shader bricks exported as Uber (#153), not written" + (new DzFile(sOut + "/" + sName + ".mi").exists() ? " (the earlier .mi kept)" : ""));
            nFailed++;
        } else {
            var bWritten = new DzFile(sMi).exists();
            if (bWritten) {
                writeText(sTmp + "/" + sName + ".lowest.json", lowest());
                keepTmp();
            }
            log(sName + ": " + oResult + ", " + (bWritten ? "written" : "missing") + (aModules.length ? " (" + aModules.join(", ") + ")" : ""));
        }
        clearTmp();
        Scene.clear();
        settle(2000);
    }
    new DzDir(sOut).rmdir(sTmp);
    var f = new DzFile(sOut + "/export-mi.done");
    f.open(DzFile.WriteOnly | DzFile.Truncate);
    f.write((oExporter ? "" : "no DzMIExporter\n") + (nFailed ? "FAILED " + nFailed + "\n" : "") + sLog);
    f.close();
    App.delayedExit();
})();
