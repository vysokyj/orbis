// ORBIS calibration (#66): a figure for an eye close-up, built headless
// from Calib-L-Distant-45 (calib/scenes) by scripts/dev/daz-script.sh with
// DONE_FILE=<out>.done. Arguments: base .duf, the figure's .duf (People/
// Genesis 9/Genesis 9.duf - DAZ's free base figure - for the scenes in
// git; a store figure only for a local, private scene), out .duf, "--",
// then the content directories. The cubes and the sphere go, the figure
// comes in at the origin with its default eyes, tear and eyelashes.
// scripts/dev/make-eye-scenes.py aims the camera and writes the variants.
// ECMAScript 3, ASCII only.
(function () {
    var a = App.scriptArgs;
    var sBase = a[0], sFigure = a[1], sOut = a[2];
    var oContent = App.getContentMgr();
    for (var i = 4; i < a.length; i++) oContent.addContentDirectory(a[i], false);
    var sLog = "";
    function done(s) {
        var f = new DzFile(sOut + ".done");
        f.open(DzFile.WriteOnly | DzFile.Truncate);
        f.write(s + "\n" + sLog);
        f.close();
        App.delayedExit();
    }
    if (!oContent.openFile(sBase, false)) { done("base not opened"); return; }
    var aGone = [];
    for (var k = 0; k < Scene.getNumNodes(); k++) {
        var o = Scene.getNode(k);
        var sLabel = o.getLabel();
        if (sLabel.indexOf("Cube") == 0 || sLabel == "Sphere") aGone.push(o);
    }
    for (var g = 0; g < aGone.length; g++) Scene.removeNode(aGone[g]);
    sLog += "removed " + aGone.length + "\n";
    Scene.selectAllNodes(false);
    sLog += "figure " + oContent.openFile(sFigure, true) + "\n";
    var nFig = 0;
    for (var m = 0; m < Scene.getNumNodes(); m++) {
        var p = Scene.getNode(m);
        if (p.inherits("DzFigure")) { nFig++; sLog += "  " + p.getLabel() + "\n"; }
    }
    if (!nFig) { done("figure not loaded"); return; }
    done("saved " + Scene.saveScene(sOut));
})();
